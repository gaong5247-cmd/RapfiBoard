<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <queries><intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent></queries>
    <application
        android:allowBackup="false"
        android:label="RapfiBoard"
        android:icon="@drawable/rapfi_launcher"
        android:roundIcon="@drawable/rapfi_launcher"
        android:theme="@style/AppTheme"
        android:extractNativeLibs="true"
        android:supportsRtl="true">
        <activity android:name=".ui.MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
    </application>
</manifest>
